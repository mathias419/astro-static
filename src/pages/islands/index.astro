---
import Title from "../../components/Pokemons/shared/Title.astro";
import { Counter } from "../../components/Counter";
import MainLayout from "../../layouts/MainLayout.astro";
import "../../styles/global.css";

const counterValue = 20;
---

<MainLayout title="Favoritos">
  <Title>Islas</Title>

  <video controls="" autoplay="" transition:persist>
  <source
    src="https://www.youtube.com/watch?v=YKidndVBat4"
    type="video/mp4"
  />
</video>

  <div
    style={{
      height: '2000px',
      backgroundColor: 'red',
      opacity: 0.4,
    }}
  >
  </div>

 <Counter 
  transition:persist="counter"
  transition:persist-props
  client:visible
  initValue={counterValue}>
 <Title> Counter Island</Title>
 </Counter>
</MainLayout>